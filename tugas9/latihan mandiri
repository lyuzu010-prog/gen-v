let buku = ["Laskar Pelangi", "Komik Naruto", "Bumi Manusia"];

// 1. Hapus elemen terakhir ("Bumi Manusia")
buku.pop();

// 2. Tambahkan satu elemen di awal ("Filosofi Teras")
buku.unshift("Filosofi Teras");

console.log(buku);
// Output: ["Filosofi Teras", "Laskar Pelangi", "Komik Naruto"]





